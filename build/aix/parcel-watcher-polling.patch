+// Per-watcher state for polling subscriptions.
+struct BruteForcePollState {
+  std::shared_ptr<DirTree> tree;     // last scan, private to this watcher
+  std::thread thread;
+  std::atomic<bool> stop{false};
+  Signal wake;                        // poked by unsubscribe for a prompt exit
+};
+
+// Poll interval in milliseconds. Override with PARCEL_WATCHER_POLL_INTERVAL_MS.
+// Scans that take long automatically stretch the interval so a huge tree can
+// never keep a CPU busy: the next wait is at least three times the scan time.
+static std::chrono::milliseconds pollInterval() {
+  static std::chrono::milliseconds interval = [] {
+    const char *env = std::getenv("PARCEL_WATCHER_POLL_INTERVAL_MS");
+    long ms = env ? std::atol(env) : 0;
+    if (ms < 250) ms = 2000;
+    return std::chrono::milliseconds(ms);
+  }();
+  return interval;
+}
+#endif
