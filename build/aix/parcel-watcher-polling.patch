+
+#ifdef BRUTE_FORCE_POLLING
+void BruteForceBackend::subscribe(WatcherRef watcher) {
+  // Called with Backend::mMutex held (Backend::watch). Take the initial
+  // snapshot synchronously so a missing/unreadable directory is reported to
+  // the caller as a normal error instead of from the poll thread.
+  auto state = std::make_shared<BruteForcePollState>();
+  state->tree = std::make_shared<DirTree>(watcher->mDir);
+  readTree(watcher, state->tree);
+  state->tree->isComplete = true;
+  mPollers[watcher] = state;
+  state->thread = std::thread([this, watcher, state]() {
+    pollLoop(watcher, state);
+  });
+}
+
+void BruteForceBackend::unsubscribe(WatcherRef watcher) {
+  // Called with Backend::mMutex held. The poll thread never takes that mutex
+  // (it only touches the watcher and its private tree), so joining is safe.
+  auto found = mPollers.find(watcher);
+  if (found == mPollers.end()) {
+    return;
+  }
+  auto state = found->second;
+  mPollers.erase(found);
+  state->stop = true;
+  state->wake.notify();
+  if (state->thread.joinable()) {
+    if (state->thread.get_id() == std::this_thread::get_id()) {
+      state->thread.detach();
+    } else {
+      state->thread.join();
+    }
+  }
+}
+
+void BruteForceBackend::pollLoop(WatcherRef watcher, std::shared_ptr<BruteForcePollState> state) {
+  auto wait = pollInterval();
+  while (!state->stop) {
+    state->wake.waitFor(wait);
+    if (state->stop) {
+      break;
+    }
+
+    auto started = std::chrono::steady_clock::now();
+    auto now = std::make_shared<DirTree>(watcher->mDir);
+    try {
+      readTree(watcher, now);
+    } catch (std::exception &err) {
+      struct stat st;
+      if (stat(watcher->mDir.c_str(), &st) != 0 && errno == ENOENT) {
+        // The watched root is gone. Report it the way the native backends
+        // do, as a delete of the root, and stop: a directory recreated under
+        // the same name is not the same watch.
+        watcher->mEvents.remove(watcher->mDir);
+        watcher->notify();
+        break;
+      }
+      // Transient (directory being replaced, EMFILE...): report once via the
+      // event stream and keep polling; the next successful scan resyncs.
+      watcher->mEvents.error(err.what());
+      watcher->notify();
+      continue;
+    }
+    now->isComplete = true;
+
+    now->getChanges(state->tree.get(), watcher->mEvents);
+    state->tree = now;
+    // notify() only wakes the debouncer when events were queued.
+    watcher->notify();
+
+    auto spent = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started);
+    wait = std::max(pollInterval(), spent * 3);
+  }
+}
+#endif
