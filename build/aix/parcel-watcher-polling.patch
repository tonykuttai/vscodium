+#include <stdexcept>
 #include "../DirTree.hh"
 #include "../Event.hh"
 #include "./BruteForceBackend.hh"
 
+#ifdef BRUTE_FORCE_POLLING
+#include <atomic>
+#include <chrono>
+#include <sys/stat.h>
