AIX support for node-pty's unix backend.

Extracted from tonykuttai/node-pty (branch main) as the difference to the
upstream microsoft/node-pty commit it was forked from, and applied on top of
whatever upstream tag the VSCodium server bundles. AIX has no <pty.h>
openpty/forkpty in libc; portlibforaix provides them in libutil.so.2, which
the build links explicitly and ships in lib/native-libs/.

Applies cleanly (with offsets) to v1.1.0 .. v1.2.0-beta.15.

--- a/src/unix/pty.cc
+++ b/src/unix/pty.cc
@@ -18,6 +18,10 @@
  */

 #define NODE_ADDON_API_DISABLE_DEPRECATED
+#if defined(_AIX)
+#include <cstdio>
+#include <cstdarg>
+#endif
 #include <napi.h>
 #include <assert.h>
 #include <errno.h>
@@ -42,6 +46,20 @@
 #elif defined(__FreeBSD__)
 #include <libutil.h>
 #include <termios.h>
+#elif defined(_AIX)
+// AIX has no <pty.h>; openpty/forkpty/login_tty come from portlibforaix's libutil
+// (prototypes declared below) and termios from <termios.h>.
+#include <termios.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <cstddef>
+#include <string>
+#include <vector>
+#include <csignal>
+#include <sys/types.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/ioctl.h>
 #endif

 /* Some platforms name VWERASE and VDISCARD differently */
@@ -64,6 +81,8 @@
 #include <sys/event.h>
 #include <sys/sysctl.h>
 #include <termios.h>
+#elif defined(_AIX)
+#include <stdlib.h>
 #endif

 /* NSIG - macro for highest signal + 1, should be defined */
